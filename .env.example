# ── work-warp broker environment ─────────────────────────────────────────────
# Copy to .env.local (dev) or inject at runtime (prod). .env is never
# committed (Guiding Light §5.1); only safe defaults live here.

APP_ENV=dev
APP_SECRET=
DEFAULT_URI=http://localhost
LOG_LEVEL=info

# ── The exec semaphore ───────────────────────────────────────────────────────
# How many command containers may run at once is enforced with a lock rather
# than counted in a variable, so it cannot drift after a crash. `flock` is the
# right default: the semaphore must not depend on a service that might be down,
# and there is one broker per daemon, so cross-host coordination is not needed.
LOCK_DSN=flock

# ── Docker access ────────────────────────────────────────────────────────────
# The socket proxy. The broker is the ONLY thing that talks to it, and it sits
# on a network the session is not on: a terminal that wants Docker work asks the
# broker, and a terminal that asks for something the broker cannot express is
# refused by absence rather than by policy (DOCKER-ACCESS.md §2, §4).
#
# The address is the proxy, never the daemon socket. Nothing here mounts
# /var/run/docker.sock.
WW_DOCKER_HOST=tcp://lyra-dockerproxy:2375

# The shared secret between the broker and its clients — bin/ww-run today, the
# MCP surface later. A holder can ask the broker to run things; a holder cannot
# ask it to run things as root, with capabilities, with a device, or with a
# second mount, because those are not in its vocabulary.
#
# Generate with: openssl rand -hex 32
WW_TOKEN=

# The image command containers are created from. Nothing in a request can change
# this — the image is configuration, and the command is the only variable.
#
# Published by the same bake run as the broker (docker-bake.hcl, target
# `base`): a push to main publishes :develop-base, a release publishes
# :latest-base and :<version>-base. A locally built tag works too —
# `docker buildx bake base`.
WW_IMAGE=digitaladapt/work-warp:latest-base

# How many commands may run at once in one workspace. Two is the shipped
# default because the host also runs everything else; raise it deliberately, on
# a machine you are willing to see briefly busy.
#
# The unit is the workspace, not the session. Today `POST /v1/sessions` creates
# both together, so this reads as a per-session cap — but when sessions can share
# a workspace they will share its budget, because the workspace is what contends
# for disk and daemon. See docs/design/DOCKER-ACCESS.md §6b.
WW_MAX_CONCURRENCY=2

# The TTL grace period, in seconds, added to a command's own timeout to get the
# ww.ttl label. The broker reaps its own containers; this is the backstop the
# janitor uses when the broker did not get to.
WW_TTL_GRACE=300

# ── Notes on the exec budget ─────────────────────────────────────────────────
# The cap is enforced by a pool of file locks (one per slot) in the system temp
# directory, not by a counter in memory: a crashed broker frees its slots when
# the kernel closes its file descriptors, so there is nothing to reconcile after
# a restart. It is machine-local — running a second broker against the same
# daemon would not share the budget, which is fine for one broker and worth
# knowing before there are two.
