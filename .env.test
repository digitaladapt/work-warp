# Test environment. Committed (Guiding Light §5.1).
#
# APP_ENV must be here, not only in phpunit.dist.xml. The <server> entry there
# populates $_SERVER, but Dotenv loads this file into $_ENV afterwards and
# Symfony's KernelTestCase reads $_ENV first — so without this line the kernel
# boots in dev (where framework.test is false) and every functional test fails
# with "you cannot create the client". Took a bisect on $_ENV vs $_SERVER to
# find; it belongs in both places.
APP_ENV=test
APP_SECRET='$ecretf0rt3st'
KERNEL_CLASS='App\Kernel'
LOCK_DSN=flock

# Deliberately set to an address that does not exist: the test suite asserts
# what the broker *builds*, never what it reaches. A test that needed a daemon
# would only run on a developer's machine, and the pieces worth testing here
# (the request vocabulary, the container specification, session naming) are
# exactly the pieces that must not depend on one.
WW_DOCKER_HOST=tcp://docker.invalid:2375
WW_TOKEN=test-token
WW_IMAGE=workwarp-base:test
WW_MAX_CONCURRENCY=1
