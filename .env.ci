# CI environment. Committed; must contain no secrets (Guiding Light §8.1).
#
# This file is what makes the CI template reusable across repos: the workflow
# copies a repo-specific .env.ci into .env.local before running the suite. The
# WW_* values are placeholders — anything that needs a real Docker daemon is a
# separate, later workflow, because a demo daemon in CI is not the daemon the
# broker will meet in production.
APP_ENV=test
APP_SECRET=ci-secret-not-a-secret
DEFAULT_URI=http://localhost
LOG_LEVEL=info
LOCK_DSN=flock

WW_DOCKER_HOST=tcp://docker.invalid:2375
WW_TOKEN=ci-placeholder-token
WW_IMAGE=workwarp-base:ci
WW_MAX_CONCURRENCY=2
WW_TTL_GRACE=300
